<Project Sdk="WixToolset.Sdk/7.0.0">
	<PropertyGroup>
		<OutputType>Bundle</OutputType>
		<AcceptEula>wix7</AcceptEula>

		<!--
			Theme.wxl is referenced explicitly via the bootstrapper application's
			LocalizationFile attribute, so disable automatic .wxl embedding to
			avoid duplicate localization identifiers.
		-->
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

		<!-- Bundle exe is x64 to match the app payload/runtime. -->
		<InstallerPlatform>x64</InstallerPlatform>

		<!--
			MsiPath  - the built UptimeWidget MSI to wrap (required).
			RuntimeExe - a local copy of the .NET 10 Desktop Runtime installer,
			             used only to harvest RemotePayload metadata at build time.
			             The runtime is still downloaded on demand at install time
			             (ExePackagePayload Compressed="no" + DownloadUrl).
			These are supplied by the CI workflow (or a manual solution build).
		-->
		<MsiPath Condition="'$(MsiPath)' == ''">$(MSBuildThisFileDirectory)..\UptimeWidgetInstaller\bin\$(Platform)\$(Configuration)\en-US\UptimeWidgetInstaller.msi</MsiPath>
		<RuntimeExe Condition="'$(RuntimeExe)' == ''">$(MSBuildThisFileDirectory)obj\windowsdesktop-runtime-win-x64.exe</RuntimeExe>
		<RuntimeUrl>https://aka.ms/dotnet/10.0/windowsdesktop-runtime-win-x64.exe</RuntimeUrl>

		<DefineConstants>$(DefineConstants);MsiPath=$(MsiPath);RuntimeExe=$(RuntimeExe)</DefineConstants>

		<!-- Optional bundle output file name, supplied by the build. -->
		<OutputName Condition="'$(InstallerName)' != ''">$(InstallerName)</OutputName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="7.0.0" />
		<PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
	</ItemGroup>

	<!--
		Fetch the .NET 10 Desktop Runtime installer used only to harvest
		RemotePayload size/hash metadata at build time. Downloading it here
		makes the solution build self-sufficient (Visual Studio and CI) so no
		external script is required. The runtime is still downloaded on demand
		at install time.
	-->
	<Target Name="DownloadRuntimePayload" BeforeTargets="BeforeBuild" Condition="!Exists('$(RuntimeExe)')">
		<MakeDir Directories="$([System.IO.Path]::GetDirectoryName($(RuntimeExe)))" />
		<Message Importance="high" Text="Downloading .NET Desktop Runtime payload from $(RuntimeUrl)..." />
		<DownloadFile SourceUrl="$(RuntimeUrl)" DestinationFolder="$([System.IO.Path]::GetDirectoryName($(RuntimeExe)))" DestinationFileName="$([System.IO.Path]::GetFileName($(RuntimeExe)))" SkipUnchangedFiles="true" />
	</Target>
</Project>
